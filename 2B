
#include <stdio.h>
#include <string.h>

#define MAXSIZE 3
#define MAXLEN 100

char q[MAXSIZE][MAXLEN];
int front = -1, rear = -1;

void insert()
{
    if ((rear + 1) % MAXSIZE == front)
    {
        printf("\nQueue is full. Cannot add more messages.\n");
    }
    else
    {
        printf("\nEnter the message to be added: ");
        getchar();

        rear = (rear + 1) % MAXSIZE;

        fgets(q[rear], MAXLEN, stdin);
        q[rear][strcspn(q[rear], "\n")] = '\0';

        if (front == -1)
        {
            front = 0;
        }

        printf("\nMessage '%s' sent successfully.\n", q[rear]);
    }
}

void delete()
{
    if (front == -1)
    {
        printf("\nQueue is empty. Cannot delete any messages.\n");
    }
    else
    {
        printf("\nMessage '%s' received\n", q[front]);

        if (front == rear)
        {
            front = -1;
            rear = -1;
        }
        else
        {
            front = (front + 1) % MAXSIZE;
        }
    }
}

void display()
{
    if (front == -1)
    {
        printf("\nQueue is empty\n");
    }
    else
    {
        printf("\nQueue status (messages):\n");

        int i = front;

        while (1)
        {
            printf("%s\n", q[i]);

            if (i == rear)
                break;

            i = (i + 1) % MAXSIZE;
        }
    }
}

int main()
{
    int ch;

    while (1)
    {
        printf("\n1. Send Message\n");
        printf("2. Receive Message\n");
        printf("3. Display Messages\n");
        printf("4. Exit\n");

        printf("\nEnter your choice: ");
        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                insert();
                break;

            case 2:
                delete();
                break;

            case 3:
                display();
                break;

            case 4:
                return 0;

            default:
                printf("\nInvalid choice\n");
        }
    }
}
