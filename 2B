
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

#define MAXSIZE 100

char queue[MAXSIZE][MAXSIZE];
int front = -1;
int rear = -1;

// Insert a message into the circular queue
void insert(void) {
    char message[MAXSIZE];

    if ((rear + 1) % MAXSIZE == front) {
        printf("Queue is full!\n");
        return;
    }

    printf("Enter the message to be added: ");
    getchar();

    if (fgets(message, MAXSIZE, stdin) == NULL) {
        printf("Input error!\n");
        return;
    }

    message[strcspn(message, "\n")] = '\0';

    if (front == -1) {
        front = 0;
    }

    rear = (rear + 1) % MAXSIZE;
    strcpy(queue[rear], message);

    printf("Message inserted successfully.\n");
}

// Delete a message from the circular queue
void deleteMessage(void) {
    if (front == -1) {
        printf("Queue is empty!\n");
        return;
    }

    printf("Deleted message: %s\n", queue[front]);

    if (front == rear) {
        front = rear = -1;
    } else {
        front = (front + 1) % MAXSIZE;
    }
}

// Display all messages in the circular queue
void display(void) {
    int i;

    if (front == -1) {
        printf("Queue is empty!\n");
        return;
    }

    printf("Messages in the queue:\n");

    i = front;

    while (1) {
        printf("%s\n", queue[i]);

        if (i == rear) {
            break;
        }

        i = (i + 1) % MAXSIZE;
    }
}

// Main function
int main(void) {
    int choice;

    while (1) {
        printf("\n--- Circular Queue Menu ---\n");
        printf("1. Insert message\n");
        printf("2. Delete message\n");
        printf("3. Display messages\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input!\n");
            break;
        }

        switch (choice) {
            case 1:
                insert();
                break;

            case 2:
                deleteMessage();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting program.\n");
                return 0;

            default:
                printf("Invalid choice! Enter 1-4.\n");
        }
    }

    return 0;
}
