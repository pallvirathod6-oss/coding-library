
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

#define SIZE 50

char stack[SIZE];
int top = -1;

void push(char x)
{
    if (top == SIZE - 1)
    {
        printf("Stack overflow\n");
        return;
    }

    stack[++top] = x;
}

char pop()
{
    if (top == -1)
        return '\0';

    return stack[top--];
}

int prior(char x)
{
    if (x == '(' || x == '#')
        return 1;
    if (x == '+' || x == '-')
        return 2;
    if (x == '*' || x == '/')
        return 3;
    if (x == '^' || x == '$')
        return 4;

    return 0;
}

int main()
{
    int i, j = 0;
    char infix[SIZE], postfix[SIZE];

    printf("Enter the infix expression:\n");
    scanf("%49s", infix);

    push('#');

    for (i = 0; i < strlen(infix); i++)
    {
        if (isalnum((unsigned char)infix[i]))
        {
            postfix[j++] = infix[i];
        }
        else if (infix[i] == '(')
        {
            push(infix[i]);
        }
        else if (infix[i] == ')')
        {
            while (top != -1 && stack[top] != '(' && stack[top] != '#')
            {
                postfix[j++] = pop();
            }

            if (top != -1 && stack[top] == '(')
                pop();
        }
        else
        {
            while (top != -1 && stack[top] != '#' &&
                   prior(stack[top]) >= prior(infix[i]))
            {
                postfix[j++] = pop();
            }

            push(infix[i]);
        }
    }

    while (top != -1 && stack[top] != '#')
    {
        postfix[j++] = pop();
    }

    postfix[j] = '\0';

    printf("Postfix expression is:\n");
    printf("%s\n", postfix);

    return 0;
}
