
#include <stdio.h>
#include <stdlib.h>

#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

// Insert an element into the queue
void insert(void) {
    int x;

    if (rear == SIZE - 1) {
        printf("Queue is full! Cannot insert any element.\n");
        return;
    }

    printf("Enter the element to insert: ");
    if (scanf("%d", &x) != 1) {
        printf("Invalid input!\n");
        return;
    }

    if (front == -1) {
        front = 0;
    }

    rear++;
    queue[rear] = x;

    printf("Element %d inserted successfully.\n", x);
}

// Delete an element from the queue
void deleteElement(void) {
    if (front == -1 || front > rear) {
        printf("Queue is empty! Nothing to delete.\n");
        return;
    }

    printf("Deleted element: %d\n", queue[front]);
    front++;

    if (front > rear) {
        front = rear = -1;
    }
}

// Display the queue elements
void display(void) {
    int i;

    if (front == -1) {
        printf("Queue is empty!\n");
        return;
    }

    printf("Elements in the queue are:\n");

    for (i = front; i <= rear; i++) {
        printf("%d ", queue[i]);
    }

    printf("\n");
}

// Main function
int main(void) {
    int choice;

    while (1) {
        printf("\n--- Queue Operations ---\n");
        printf("1. Insert\n");
        printf("2. Delete\n");
        printf("3. Display\n");
        printf("4. Exit\n");

        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input!\n");
            break;
        }

        switch (choice) {
            case 1:
                insert();
                break;

            case 2:
                deleteElement();
                break;

            case 3:
                display();
                break;

            case 4:
                printf("Exiting program.\n");
                return 0;

            default:
                printf("Invalid choice! Please enter 1-4.\n");
        }
    }

    return 0;
}
