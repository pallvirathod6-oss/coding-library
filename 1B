
#include <stdio.h>
#include <stdlib.h>

#define SIZE 3

int queue[SIZE], front = -1, rear = -1;

void insert()
{
    int x;

    if (rear == SIZE - 1)
    {
        printf("Queue is full\n");
        return;
    }
    else if (rear == -1)
    {
        front = rear = 0;
    }
    else
    {
        rear++;
    }

    printf("Enter the element\n");
    scanf("%d", &x);

    queue[rear] = x;
}

void delete()
{
    if (front == -1 && rear == -1)
    {
        printf("Queue is empty\n");
        return;
    }

    printf("Element %d is deleted\n", queue[front]);

    if (front == rear)
    {
        front = rear = -1;
    }
    else
    {
        front++;
    }
}

void display()
{
    if (front == -1 && rear == -1)
    {
        printf("Queue is empty\n");
        return;
    }

    printf("Elements of queue are:\n");

    for (int i = front; i <= rear; i++)
    {
        printf("%d ", queue[i]);
    }

    printf("\n");
}

int main()
{
    int ch;

    for (;;)
    {
        printf("\nEnter an operation\n");
        printf("1. Insert\n");
        printf("2. Delete\n");
        printf("3. Display\n");
        printf("4. Exit\n");

        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                insert();
                break;

            case 2:
                delete();
                break;

            case 3:
                display();
                break;

            case 4:
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}
