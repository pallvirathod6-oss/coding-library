
#include <stdio.h>
#include <stdlib.h>
#include <ctype.h>
#include <string.h>

#define SIZE 200

char stack[SIZE];
int top = -1;

void push(char ch) {
    if (top == SIZE - 1) {
        printf("Stack Overflow!\n");
        exit(1);
    }
    stack[++top] = ch;
}

char pop(void) {
    if (top == -1) {
        return '\0';
    }
    return stack[top--];
}

char peek(void) {
    if (top == -1) {
        return '\0';
    }
    return stack[top];
}

int precedence(char op) {
    switch (op) {
        case '^':
            return 3;
        case '*':
        case '/':
        case '%':
            return 2;
        case '+':
        case '-':
            return 1;
        default:
            return 0;
    }
}

int isOperator(char ch) {
    return ch == '+' || ch == '-' ||
           ch == '*' || ch == '/' ||
           ch == '%' || ch == '^';
}

int infixToPostfix(char infix[], char postfix[]) {
    int i, j = 0;
    char ch;

    for (i = 0; infix[i] != '\0'; i++) {
        ch = infix[i];

        if (isspace((unsigned char)ch)) {
            continue;
        }

        if (isalnum((unsigned char)ch)) {
            postfix[j++] = ch;
        }
        else if (ch == '(') {
            push(ch);
        }
        else if (ch == ')') {
            while (top != -1 && peek() != '(') {
                postfix[j++] = pop();
            }

            if (top == -1) {
                return 0;
            }

            pop();
        }
        else if (isOperator(ch)) {
            while (top != -1 && peek() != '(' &&
                   (precedence(peek()) > precedence(ch) ||
                   (precedence(peek()) == precedence(ch)
                    && ch != '^'))) {
                postfix[j++] = pop();
            }

            push(ch);
        }
        else {
            return 0;
        }
    }

    while (top != -1) {
        if (peek() == '(') {
            return 0;
        }

        postfix[j++] = pop();
    }

    postfix[j] = '\0';
    return 1;
}

int main(void) {
    char infix[SIZE];
    char postfix[SIZE];

    printf("Enter an infix expression: ");

    if (fgets(infix, sizeof(infix), stdin) == NULL) {
        printf("Invalid input!\n");
        return 1;
    }

    top = -1;

    if (infixToPostfix(infix, postfix)) {
        printf("Infix expression: %s", infix);
        printf("Postfix expression: %s\n", postfix);
    }
    else {
        printf("Invalid expression!\n");
    }

    return 0;
}
