
#include <stdio.h>
#include <stdlib.h>

struct Node {
    int data;
    struct Node *next;
};

typedef struct Node* node;

node head = NULL;

// Insert a node at a given position
void insertAtPosition(int value, int pos) {
    node newNode = (node)malloc(sizeof(struct Node));

    if (newNode == NULL) {
        printf("Memory allocation failed!\n");
        return;
    }

    newNode->data = value;
    newNode->next = NULL;

    // Insert at the beginning
    if (pos == 1) {
        newNode->next = head;
        head = newNode;
        printf("Node inserted successfully.\n");
        return;
    }

    node temp = head;

    // Move to the node before the required position
    for (int i = 1; i < pos - 1 && temp != NULL; i++) {
        temp = temp->next;
    }

    if (temp == NULL) {
        printf("Invalid position!\n");
        free(newNode);
        return;
    }

    newNode->next = temp->next;
    temp->next = newNode;

    printf("Node inserted successfully.\n");
}

// Delete a node from the beginning
void deleteAtBeginning(void) {
    if (head == NULL) {
        printf("List is empty. Nothing to delete.\n");
        return;
    }

    node temp = head;
    head = head->next;

    printf("Deleted element: %d\n", temp->data);
    free(temp);
}

// Display the linked list
void display(void) {
    node temp = head;

    if (head == NULL) {
        printf("List is empty.\n");
        return;
    }

    printf("Linked list: ");

    while (temp != NULL) {
        printf("%d -> ", temp->data);
        temp = temp->next;
    }

    printf("NULL\n");
}

// Main function
int main(void) {
    int choice, value, pos;

    while (1) {
        printf("\n--- Singly Linked List Menu ---\n");
        printf("1. Insert at a position\n");
        printf("2. Delete at beginning\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input!\n");
            break;
        }

        switch (choice) {
            case 1:
                printf("Enter the value to insert: ");
                if (scanf("%d", &value) != 1) {
                    printf("Invalid input!\n");
                    goto cleanup;
                }

                printf("Enter the position (1 = beginning): ");
                if (scanf("%d", &pos) != 1) {
                    printf("Invalid input!\n");
                    goto cleanup;
                }

                if (pos < 1) {
                    printf("Position must be at least 1.\n");
                    break;
                }

                insertAtPosition(value, pos);
                display();
                break;

            case 2:
                deleteAtBeginning();
                display();
                break;

            case 3:
                display();
                break;

            case 4:
                exit(0);

            default:
                printf("Invalid choice! Please enter 1-4.\n");
        }
    }

cleanup:
    while (head != NULL) {
        node temp = head;
        head = head->next;
        free(temp);
    }

    printf("Program terminated.\n");
    return 0;
}
