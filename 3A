
#include <stdio.h>
#include <stdlib.h>

struct NODE
{
    int data;
    struct NODE *link;
};

typedef struct NODE *node;

node head = NULL;

void Finsert()
{
    int x;

    node new_node = (node)malloc(sizeof(struct NODE));

    if (new_node == NULL)
    {
        printf("Overflow\n");
        return;
    }

    printf("Enter an element\n");
    scanf("%d", &x);

    new_node->data = x;
    new_node->link = head;
    head = new_node;

    printf("Node inserted at the front\n");
}

void Fdelete()
{
    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    node current = head;
    head = head->link;
    free(current);

    printf("Node deleted at the front\n");
}

void Linsert()
{
    int x;

    printf("Enter an element\n");
    scanf("%d", &x);

    node new_node = (node)malloc(sizeof(struct NODE));

    if (new_node == NULL)
    {
        printf("Overflow\n");
        return;
    }

    new_node->data = x;
    new_node->link = NULL;

    if (head == NULL)
    {
        head = new_node;
        printf("Node inserted at the rear\n");
        return;
    }

    node current = head;

    while (current->link != NULL)
    {
        current = current->link;
    }

    current->link = new_node;

    printf("Node inserted at the rear\n");
}

void Ldelete()
{
    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    if (head->link == NULL)
    {
        free(head);
        head = NULL;
        printf("Node deleted at the rear\n");
        return;
    }

    node current = head;

    while (current->link->link != NULL)
    {
        current = current->link;
    }

    free(current->link);
    current->link = NULL;

    printf("Node deleted at the rear\n");
}

void display()
{
    if (head == NULL)
    {
        printf("List is empty\n");
        return;
    }

    node current = head;

    printf("Linked list is:\n");

    while (current != NULL)
    {
        printf("%d --> ", current->data);
        current = current->link;
    }

    printf("NULL\n");
}

int main()
{
    int ch;

    for (;;)
    {
        printf("\nEnter an operation\n");
        printf("1. Insert at front\n");
        printf("2. Delete at front\n");
        printf("3. Insert at rear\n");
        printf("4. Delete at rear\n");
        printf("5. Display\n");
        printf("6. Exit\n");

        scanf("%d", &ch);

        switch (ch)
        {
            case 1:
                Finsert();
                break;

            case 2:
                Fdelete();
                break;

            case 3:
                Linsert();
                break;

            case 4:
                Ldelete();
                break;

            case 5:
                display();
                break;

            case 6:
                while (head != NULL)
                {
                    node current = head;
                    head = head->link;
                    free(current);
                }
                return 0;

            default:
                printf("Invalid choice\n");
        }
    }

    return 0;
}
