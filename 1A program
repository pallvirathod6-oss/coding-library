
#include <stdio.h>
#include <stdlib.h>

#define MAX 100

int main()
{
    int stack[MAX];
    int top = -1;
    int choice, value;

    while (1)
    {
        printf("\nStack Operations:\n");
        printf("1. Insert (Push)\n");
        printf("2. Delete (Pop)\n");
        printf("3. Display\n");
        printf("4. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice)
        {
            case 1:
                if (top == MAX - 1)
                {
                    printf("Stack Overflow! Cannot insert more elements.\n");
                }
                else
                {
                    printf("Enter the value to insert: ");
                    scanf("%d", &value);

                    stack[++top] = value;

                    printf("Inserted %d into the stack.\n", value);
                }
                break;

            case 2:
                if (top == -1)
                {
                    printf("Stack Underflow! No elements to delete.\n");
                }
                else
                {
                    printf("Deleted value: %d\n", stack[top--]);
                }
                break;

            case 3:
                if (top == -1)
                {
                    printf("The stack is empty.\n");
                }
                else
                {
                    printf("Stack elements:\n");

                    for (int i = top; i >= 0; i--)
                    {
                        printf("%d\n", stack[i]);
                    }
                }
                break;

            case 4:
                printf("Exiting program.\n");
                exit(0);

            default:
                printf("Invalid choice! Please try again.\n");
        }
    }

    return 0;
}
