
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <ctype.h>

struct Node {
    int data;
    struct Node *prev;
    struct Node *next;
};

typedef struct Node Node;

// Create a new node
Node *createNode(int digit) {
    Node *newNode = malloc(sizeof(Node));

    if (newNode == NULL) {
        printf("Memory allocation failed!\n");
        exit(EXIT_FAILURE);
    }

    newNode->data = digit;
    newNode->prev = NULL;
    newNode->next = NULL;

    return newNode;
}

// Insert a digit at the end
void insertEnd(Node **head, Node **tail, int digit) {
    Node *newNode = createNode(digit);

    if (*head == NULL) {
        *head = *tail = newNode;
    } else {
        (*tail)->next = newNode;
        newNode->prev = *tail;
        *tail = newNode;
    }
}

// Insert a digit at the beginning
void insertFront(Node **head, Node **tail, int digit) {
    Node *newNode = createNode(digit);

    if (*head == NULL) {
        *head = *tail = newNode;
    } else {
        newNode->next = *head;
        (*head)->prev = newNode;
        *head = newNode;
    }
}

// Convert a number string into a doubly linked list
void createList(char str[], Node **head, Node **tail) {
    for (int i = 0; str[i] != '\0'; i++) {
        insertEnd(head, tail, str[i] - '0');
    }
}

// Display a number
void display(Node *head) {
    if (head == NULL) {
        printf("0");
        return;
    }

    while (head != NULL) {
        printf("%d", head->data);
        head = head->next;
    }

    printf("\n");
}

// Count the number of digits
int getLength(Node *head) {
    int length = 0;

    while (head != NULL) {
        length++;
        head = head->next;
    }

    return length;
}

// Add two large integers
Node *addNumbers(Node *head1, Node *tail1,
                 Node *head2, Node *tail2) {
    Node *resultHead = NULL;
    Node *resultTail = NULL;

    int carry = 0;

    while (tail1 != NULL || tail2 != NULL || carry != 0) {
        int sum = carry;

        if (tail1 != NULL) {
            sum += tail1->data;
            tail1 = tail1->prev;
        }

        if (tail2 != NULL) {
            sum += tail2->data;
            tail2 = tail2->prev;
        }

        carry = sum / 10;
        int digit = sum % 10;

        insertFront(&resultHead, &resultTail, digit);
    }

    return resultHead;
}

// Free the linked list
void freeList(Node *head) {
    while (head != NULL) {
        Node *temp = head;
        head = head->next;
        free(temp);
    }
}

// Validate a positive integer string
int isValidNumber(char str[]) {
    if (str[0] == '\0') {
        return 0;
    }

    for (int i = 0; str[i] != '\0'; i++) {
        if (!isdigit((unsigned char)str[i])) {
            return 0;
        }
    }

    return 1;
}

int main(void) {
    char num1[1000], num2[1000];

    Node *head1 = NULL, *tail1 = NULL;
    Node *head2 = NULL, *tail2 = NULL;
    Node *resultHead = NULL;

    printf("Enter first positive integer: ");
    if (scanf("%999s", num1) != 1 || !isValidNumber(num1)) {
        printf("Invalid first integer.\n");
        return 1;
    }

    printf("Enter second positive integer: ");
    if (scanf("%999s", num2) != 1 || !isValidNumber(num2)) {
        printf("Invalid second integer.\n");
        return 1;
    }

    createList(num1, &head1, &tail1);
    createList(num2, &head2, &tail2);

    printf("\nFirst number: ");
    display(head1);

    printf("Second number: ");
    display(head2);

    resultHead = addNumbers(head1, tail1, head2, tail2);

    printf("Sum: ");
    display(resultHead);

    freeList(head1);
    freeList(head2);
    freeList(resultHead);

    return 0;
}
